APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
CORS_ORIGINS=["http://localhost:3000"]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 라이선스 관리 CRUD에 필수. 서버/Vercel 환경 변수에만 둡니다.
SUPABASE_SECRET_KEY=
# 관리 콘솔 BFF가 X-Admin-Key로 전달하는 별도 서버 전용 키입니다.
ADMIN_API_KEY=
SUPABASE_TIMEOUT_SECONDS=5.0
